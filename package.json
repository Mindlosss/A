{
  "name": "gastos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "app": "npm run build && python app.py",
    "app:dev": "python app.py --dev",
    "exe": "npm run build && python -m PyInstaller --noconfirm --clean --onefile --windowed --name Gastos --icon ../assets/icon.ico --add-data \"../dist;dist\" --distpath build/exe --workpath build/work --specpath build app.py"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@number-flow/react": "^0.6.2",
    "lucide-react": "^1.48.0",
    "motion": "^13.4.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
